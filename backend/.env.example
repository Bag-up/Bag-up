# Connexion PostgreSQL utilisée par Prisma (voir prisma/schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bagup?schema=public"

JWT_SECRET=bagup-secret-dev-change-in-production
PORT=3000

# URL publique de l'API (utilisée pour les URLs d'upload en mode disque local)
PUBLIC_API_URL=http://localhost:3000

# WhatsApp Business API (Meta) — optionnel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Orange SMS Pro (Sénégal) — prioritaire ────────────────────────────────
# Portail : https://www.orangesmspro.sn → Mes applications - WS → Alert SMS
# key = HMAC-SHA1(token+subject+signature+recipient+content+timestamp, clé privée)
ORANGE_SMS_LOGIN=
ORANGE_SMS_PASSWORD=
ORANGE_SMS_TOKEN=
ORANGE_SMS_PRIVATE_KEY=
# Signature / expéditeur (doit être Approuvée dans Signatures)
ORANGE_SMS_SENDER=Bagup
ORANGE_SMS_URL=https://api.orangesmspro.sn:8443/api

# ─── Vonage SMS (Messages API) — fallback optionnel ─────────────────────────
# https://www.vonage.com/ — OTP, notifications SMS
# Dashboard : https://dashboard.nexmo.com/ → Messaging API type = Messages API
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Expéditeur alphanumérique (ex: Bagup) — doit contenir le nom de marque (SN)
VONAGE_FROM=Bagup
# Optionnel — endpoint Messages API
VONAGE_MESSAGES_URL=https://api.nexmo.com/v1/messages

# OTP — true = affiche le code dans l'app (mode dev). Mettre false en production.
OTP_SHOW_DEV_CODE=false

# ─── Resend (emails) ────────────────────────────────────────────────────────
# https://resend.com/ — inscription, reset password, confirmations
# Prioritaire sur SMTP si les deux sont renseignés.
RESEND_API_KEY=
RESEND_FROM="Bag'up <no-reply@bagupafrica.com>"

# Email SMTP (fallback si Resend absent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bag'up <no-reply@bagupafrica.com>"

# ─── Cloudinary (stockage fichiers) ─────────────────────────────────────────
# https://cloudinary.com/ — photos missions, KYC prestataires, chat
# Sans clés : fallback disque local (./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bagup

# ─── Paiements ──────────────────────────────────────────────────────────────
# Tant que les clés ci-dessous sont vides, le backend bascule automatiquement
# sur le MockProvider (paiement simulé) — aucune régression en développement.

# Bictorys — paiements locaux (Wave, Orange Money, carte) — https://docs.bictorys.com
# Sandbox: https://api.test.bictorys.com  |  Prod: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_PRIVATE_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_MERCHANT_SECRET_CODE=

# URL du back-office (liens dans les emails/SMS d’alerte staff)
# ADMIN_WEB_URL=https://admin.bagup.app

# Pages de retour après paiement (Stripe / Bictorys)
# PAYMENT_SUCCESS_URL=https://admin.bagup.app/payment/success
# PAYMENT_ERROR_URL=https://admin.bagup.app/payment/error

# Stripe — paiements internationaux par carte (diaspora) — https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Clé publique (optionnelle côté backend / docs ; utilisée surtout mobile/admin)
STRIPE_PUBLISHABLE_KEY=

# ─── Google Maps / Places (backend : géocodage, etc.) ───────────────────────
# Clé « BagUp - Backend » depuis Google Cloud Console
GOOGLE_MAPS_API_KEY=
