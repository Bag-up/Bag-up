# URL de l'API backend Bag'up.
# Doit pointer vers l'IP LAN du Mac (pas localhost) pour un téléphone / Expo Go.
# Trouver l'IP : ipconfig getifaddr en0
# Exemple : http://192.168.1.29:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.29:3000/api

# ─── Google Maps (clés séparées par plateforme — Google Cloud Console) ─────
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# ─── Stripe (clé publique uniquement côté app) ─────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
